{
  "name": "catalog-agent",
  "version": "0.0.0",
  "description": "An MCP server for the product catalogue (catalog-api v1.1.0), and a tool-calling agent that uses it",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
