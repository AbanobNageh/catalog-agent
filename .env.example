# Copy to .env for local runs: Copy-Item .env.example .env
# .env is git-ignored. src/config.ts checks every variable and reports all
# problems at once. Nothing loads .env yet: the first entry point (M1/M2) does.

# catalog-api from this repo's docker-compose.yml (v1.1.0). This is the default.
CATALOG_API_URL=http://localhost:3100

# The Compose dev keys are public in product-catalog and NOT secret. Use the
# least privilege the task needs:
#   read:  dev-read-key-not-secret-0000000000000000
#   write: dev-write-key-not-secret-000000000000000
#   admin: dev-admin-key-not-secret-000000000000000  (seed and test cleanup only, never the MCP server)
CATALOG_API_KEY=dev-read-key-not-secret-0000000000000000
